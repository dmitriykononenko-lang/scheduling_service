# --- Общее ---
ENVIRONMENT=local
# ОБЯЗАТЕЛЬНО смените в любом не-local окружении. Минимум 32 байта.
SECRET_KEY=change-me-please-generate-a-long-random-secret-key

# --- PostgreSQL (используется docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=scheduling

# --- Прямой DSN для бэкенда (вне docker-compose) ---
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/scheduling

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Веб ---
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Внешние сервисы (заполняются по мере подключения интеграций, ТЗ §6.4) ---
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# TBANK_TERMINAL_KEY=
# TBANK_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# SMTP_URL=
